rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function hasActiveSub() {
      return signedIn()
        && exists(/databases/$(database)/documents/subscriptions/$(request.auth.uid))
        && get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data.endDate > request.time;
    }
    function canReadText(bookId) {
      return isAdmin()
        || get(/databases/$(database)/documents/books/$(bookId)).data.accessType == 'free'
        || hasActiveSub();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == 'member';
      allow update: if isOwner(uid) && request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(['name', 'favoriteGenres', 'onboardingDone']);
      allow delete: if false;
      match /readingProgress/{bookId} { allow read, write: if isOwner(uid); }
      match /savedBooks/{bookId}      { allow read, write: if isOwner(uid); }
      match /notifications/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) || isAdmin();
        allow update: if isOwner(uid) && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['read']);
      }
    }
    match /books/{bookId} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /chapters/{chapterNo} { allow read: if canReadText(bookId); allow write: if isAdmin(); }
      match /extras/{doc}         { allow read: if canReadText(bookId); allow write: if isAdmin(); }
    }
    match /subscriptions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
      // Payment is simulated, so a Member may write their OWN subscription (demo limitation):
      allow create, update: if isOwner(uid)
        && request.resource.data.userId == uid
        && request.resource.data.startedBy == 'member'
        && request.resource.data.status == 'active'
        && request.resource.data.endDate <= request.time + duration.value(65, 'd');
    }
    match /config/{doc} { allow read: if signedIn(); allow write: if isAdmin(); }
  }
}